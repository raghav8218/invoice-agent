# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Centralized Model Name (optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Database path (optional, defaults to data/invoices.db)
DATABASE_PATH=data/invoices.db

# Gmail Search Query (optional, customize to target specific senders/labels)
# Example: GMAIL_QUERY=from:billing@company.com has:attachment
# Example: GMAIL_QUERY=label:invoices has:attachment
GMAIL_QUERY=has:attachment (filename:pdf OR filename:png OR filename:jpg OR filename:jpeg) invoice
